{
  "name": "mimocode-extensions",
  "version": "2.0.0",
  "description": "Curated hooks, tools, skills, and workflows for MiMoCode — inspired by oh-my-openagent",
  "main": "plugin.ts",
  "scripts": {
    "test": "node tests/test.js",
    "test:hooks": "node tests/test-hooks.js",
    "test:install": "node tests/test-install.js",
    "lint": "echo 'No linter configured'",
    "install": "bash install.sh",
    "install:mcp": "bash ~/.config/mimocode/.mimocode/mcp/install-mcp.sh",
    "fix:npm": "npm config set allow-scripts true"
  },
  "keywords": [
    "mimocode",
    "ai",
    "coding",
    "hooks",
    "skills",
    "mcp",
    "opencode-go"
  ],
  "author": "skllfi2",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server-filesystem": "2026.7.10",
    "@modelcontextprotocol/server-memory": "2026.7.4",
    "@modelcontextprotocol/server-github": "2025.4.8",
    "@modelcontextprotocol/server-sequential-thinking": "2026.7.4",
    "@modelcontextprotocol/server-postgres": "0.6.2",
    "@modelcontextprotocol/server-puppeteer": "2025.5.12"
  },
  "peerDependencies": {
    "mimocode": ">=0.1.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
