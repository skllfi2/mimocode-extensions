<Page
    x:Class="MimoLauncher.Views.ExtensionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent"
    Loaded="OnLoaded">

    <Grid Padding="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" 
                   Text="MiMoCode Extensions"
                   FontSize="24" FontWeight="SemiBold"
                   Margin="0,0,0,16"/>

        <!-- Status Panel -->
        <Border Grid.Row="1" 
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <StackPanel Spacing="12">
                <TextBlock Text="Status" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock x:Name="StatusText" 
                           Text="Loading..."
                           FontSize="14"/>
            </StackPanel>
        </Border>

        <!-- Progress -->
        <ProgressRing x:Name="ProgressRing" 
                      IsActive="False" 
                      Width="50" Height="50"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,16"/>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <Button Content="Install"
                    Click="Install_Click"
                    Padding="16,8"/>
            
            <Button Content="Update"
                    Click="Update_Click"
                    Padding="16,8"/>
            
            <Button Content="Update MCP"
                    Click="UpdateMcp_Click"
                    Padding="16,8"/>
            
            <Button Content="Uninstall"
                    Click="Uninstall_Click"
                    Padding="16,8"/>
        </StackPanel>
    </Grid>
</Page>
