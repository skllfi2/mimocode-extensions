<Page
    x:Class="MimoLauncher.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MimoLauncher.Models"
    xmlns:converters="using:MimoLauncher.Converters"
    mc:Ignorable="d"
    Background="Transparent"
    Loaded="OnLoaded"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <converters:NullToFalseConverter x:Key="NullToFalseConverter"/>
    </Page.Resources>

    <Grid Padding="32,24" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Header ═══ -->
        <StackPanel Grid.Row="0" Spacing="16" Margin="0,0,0,24">
            <!-- Title -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="🚀 MiMoCode Launcher" 
                           FontSize="28" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Search Box -->
            <AutoSuggestBox x:Name="SearchBox"
                           x:Uid="SearchBox"
                           QueryIcon="Find"
                           Width="400"
                           HorizontalAlignment="Left"
                           Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}"
                           QuerySubmitted="SearchBox_QuerySubmitted"/>
        </StackPanel>

        <!-- ═══ Project List ═══ -->
        <ListView x:Name="ProjectList"
                  Grid.Row="1"
                  SelectionMode="Single"
                  IsItemClickEnabled="True"
                  ItemClick="ProjectList_ItemClick"
                  SelectionChanged="ProjectList_SelectionChanged"
                  ItemsSource="{x:Bind ViewModel.Projects}">

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Project">
                    <Border Style="{StaticResource CardBorder}"
                            Padding="20,16"
                            Margin="0,0,0,8">
                        <Grid ColumnDefinitions="*,Auto">
                            <!-- Left: Project Info -->
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="{x:Bind Name}"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="{x:Bind Description}"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="2"/>
                            </StackPanel>

                            <!-- Right: Category & Date -->
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Margin="16,0,0,0" Spacing="4">
                                <Border Background="{ThemeResource InfoBrush}" 
                                        CornerRadius="4" Padding="8,4">
                                    <TextBlock Text="{x:Bind Category}"
                                               FontSize="10" FontWeight="SemiBold"
                                               Foreground="White"/>
                                </Border>
                                <TextBlock Text="{x:Bind LastUsed}"
                                           FontSize="10"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- ═══ Footer Buttons ═══ -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,24,0,0">
            <Button x:Uid="AddProjectButton"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="AddProject_Click"
                    Padding="16,8"/>

            <Button x:Uid="LaunchButton"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="LaunchMiMoCode_Click"
                    IsEnabled="{x:Bind ViewModel.SelectedProject, Converter={StaticResource NullToFalseConverter}}"
                    Padding="16,8"/>

            <Button x:Uid="OpenFolderButton"
                    Click="OpenFolder_Click"
                    IsEnabled="{x:Bind ViewModel.SelectedProject, Converter={StaticResource NullToFalseConverter}}"
                    Padding="16,8"/>

            <Button x:Uid="DeleteButton"
                    Click="DeleteProject_Click"
                    IsEnabled="{x:Bind ViewModel.SelectedProject, Converter={StaticResource NullToFalseConverter}}"
                    Padding="16,8"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>

            <!-- Status Text -->
            <TextBlock x:Name="StatusTextBlock"
                       Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center"
                       Margin="24,0,0,0"/>
        </StackPanel>
    </Grid>
</Page>
