<Window
    x:Class="MimoLauncher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MimoLauncher"
    xmlns:views="using:MimoLauncher.Views"
    Title="MiMoCode Launcher">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Padding="16,8">
            <TextBlock Text="MiMoCode Launcher" 
                       FontSize="20" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <TabView x:Name="MainTabView" Grid.Row="1" IsAddTabButtonVisible="False">
            <TabView.TabItems>
                <TabViewItem Header="Projects">
                    <views:MainPage/>
                </TabViewItem>
                <TabViewItem Header="Terminal">
                    <views:TerminalPage/>
                </TabViewItem>
                <TabViewItem Header="Extensions">
                    <views:ExtensionsPage/>
                </TabViewItem>
            </TabView.TabItems>
        </TabView>
    </Grid>
</Window>
